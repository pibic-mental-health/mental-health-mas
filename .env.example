# ==================================================
# API HTTP
# ==================================================

# Porta utilizada pelo AgenteGateway.
# Se não informada, o sistema utiliza a porta padrão definida no código.
PIBIC_API_PORT=


# ==================================================
# PostgreSQL
# ==================================================

PIBIC_DB_URL=
PIBIC_DB_USER=
PIBIC_DB_PASSWORD=


# ==================================================
# Inteligência Artificial / NVIDIA NIM
# ==================================================

LLM_PROVIDER=NVIDIA_NIM

# Nunca coloque uma chave real neste arquivo.
NVIDIA_API_KEY=

# Opcional. Se vazio, ClienteNvidia utiliza o modelo padrão definido no código.
NVIDIA_MODEL=


# ==================================================
# Serviços externos
# ==================================================

# Google Places é opcional.
GOOGLE_PLACES_API_KEY=

# Token opcional para a API de Dados Abertos da Saúde/CNES.
SAUDE_API_TOKEN=


# ==================================================
# Simulação do AgentePaciente
# ==================================================

PACIENTE_IA_ENABLED=false

# Cenário utilizado pelo AgentePaciente durante simulações.
CENARIO_PACIENTE=
