<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.pibic</groupId>
    <artifactId>mental-health-mas</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Modo padrao: preserva o fluxo de simulacao atual, incluindo AgentePaciente.
            Para subir a API, use o perfil Maven "api".
        -->
        <jade.agents>
            agenteTriagem:br.com.pibic.agentes.AgenteTriagemFormulario;
            agenteIntervencao:br.com.pibic.agentes.AgenteIntervencao;
            agenteConversacional:br.com.pibic.agentes.AgenteConversacional;
            agentePaciente:br.com.pibic.agentes.AgentePaciente;
            agenteMonitoramento:br.com.pibic.agentes.AgenteMonitoramento;
            agenteRelatorio:br.com.pibic.agentes.AgenteRelatorio;
            agenteSeguranca:br.com.pibic.agentes.AgenteSeguranca;
            agenteMemoria:br.com.pibic.agentes.AgenteMemoria;
            agenteConteudo:br.com.pibic.agentes.AgenteConteudo;
            agentePsicologo:br.com.pibic.agentes.AgentePsicologo;
            agenteLocalAtendimento:br.com.pibic.agentes.AgenteLocalAtendimento
        </jade.agents>
    </properties>

    <dependencies>

        <dependency>
            <groupId>jade</groupId>
            <artifactId>jade</artifactId>
            <version>4.6.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- Driver JDBC PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
        </dependency>

    </dependencies>

    <profiles>

        <profile>
            <id>api</id>

            <properties>
                <!--
                    Modo plataforma/API:
                    - inicia o Gateway HTTP;
                    - nao inicia o AgentePaciente, para evitar que o simulador
                      gere conversas automaticamente enquanto a API esta em uso.
                -->
                <jade.agents>
                    agenteGateway:br.com.pibic.agentes.AgenteGateway;
                    agenteTriagem:br.com.pibic.agentes.AgenteTriagemFormulario;
                    agenteIntervencao:br.com.pibic.agentes.AgenteIntervencao;
                    agenteConversacional:br.com.pibic.agentes.AgenteConversacional;
                    agenteMonitoramento:br.com.pibic.agentes.AgenteMonitoramento;
                    agenteRelatorio:br.com.pibic.agentes.AgenteRelatorio;
                    agenteSeguranca:br.com.pibic.agentes.AgenteSeguranca;
                    agenteMemoria:br.com.pibic.agentes.AgenteMemoria;
                    agenteConteudo:br.com.pibic.agentes.AgenteConteudo;
                    agentePsicologo:br.com.pibic.agentes.AgentePsicologo;
                    agenteLocalAtendimento:br.com.pibic.agentes.AgenteLocalAtendimento
                </jade.agents>
            </properties>

        </profile>

    </profiles>

    <build>

        <plugins>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>

                <configuration>

                    <mainClass>jade.Boot</mainClass>

                    <arguments>
                        <argument>-gui</argument>
                        <argument>${jade.agents}</argument>
                    </arguments>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>