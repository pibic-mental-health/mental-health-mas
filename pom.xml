<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.pibic</groupId>
    <artifactId>mental-health-mas</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Modo padrão:
            preserva o fluxo de simulação atual,
            incluindo o AgentePaciente.

            Para iniciar a plataforma com a API HTTP,
            utilizar o perfil Maven "api".
        -->
        <jade.agents>
            agenteTriagem:br.com.pibic.agentes.AgenteTriagemFormulario;
            agenteIntervencao:br.com.pibic.agentes.AgenteIntervencao;
            agenteConversacional:br.com.pibic.agentes.AgenteConversacional;
            agentePaciente:br.com.pibic.agentes.AgentePaciente;
            agenteMonitoramento:br.com.pibic.agentes.AgenteMonitoramento;
            agenteRelatorio:br.com.pibic.agentes.AgenteRelatorio;
            agenteSeguranca:br.com.pibic.agentes.AgenteSeguranca;
            agenteMemoria:br.com.pibic.agentes.AgenteMemoria;
            agenteConteudo:br.com.pibic.agentes.AgenteConteudo;
            agentePsicologo:br.com.pibic.agentes.AgentePsicologo;
            agenteLocalAtendimento:br.com.pibic.agentes.AgenteLocalAtendimento
        </jade.agents>
    </properties>

    <!--
        Repositório oficial Maven do JADE.
        Necessário porque o artefato oficial não é distribuído
        pelo Maven Central.
    -->
    <repositories>

        <repository>
            <id>tilab</id>
            <name>JADE Maven Repository</name>
            <url>https://jade.tilab.com/maven/</url>
        </repository>

    </repositories>

    <dependencies>

        <!-- JADE - Java Agent DEvelopment Framework -->
        <dependency>
            <groupId>com.tilab.jade</groupId>
            <artifactId>jade</artifactId>
            <version>4.6.0</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- Driver JDBC PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
        </dependency>

    </dependencies>

    <profiles>

        <!--
            Perfil para execução da plataforma integrada à API.

            Diferença principal em relação ao modo padrão:
            o AgentePaciente não é iniciado, evitando que o simulador
            gere conversas automaticamente enquanto o aplicativo
            utiliza a API.
        -->
        <profile>
            <id>api</id>

            <properties>

                <jade.agents>
                    agenteGateway:br.com.pibic.agentes.AgenteGateway;
                    agenteTriagem:br.com.pibic.agentes.AgenteTriagemFormulario;
                    agenteIntervencao:br.com.pibic.agentes.AgenteIntervencao;
                    agenteConversacional:br.com.pibic.agentes.AgenteConversacional;
                    agenteMonitoramento:br.com.pibic.agentes.AgenteMonitoramento;
                    agenteRelatorio:br.com.pibic.agentes.AgenteRelatorio;
                    agenteSeguranca:br.com.pibic.agentes.AgenteSeguranca;
                    agenteMemoria:br.com.pibic.agentes.AgenteMemoria;
                    agenteConteudo:br.com.pibic.agentes.AgenteConteudo;
                    agentePsicologo:br.com.pibic.agentes.AgentePsicologo;
                    agenteLocalAtendimento:br.com.pibic.agentes.AgenteLocalAtendimento
                </jade.agents>

            </properties>

        </profile>

    </profiles>

    <build>

        <plugins>

            <!-- Permite iniciar diretamente o jade.Boot via Maven -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>

                <configuration>

                    <mainClass>jade.Boot</mainClass>

                    <arguments>
                        <argument>-gui</argument>
                        <argument>${jade.agents}</argument>
                    </arguments>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>